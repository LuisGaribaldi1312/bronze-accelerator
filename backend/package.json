{
  "name": "codigo-company-backend",
  "version": "0.1.0",
  "description": "Backend API for CODIGO COMPANY - Gestión Ambiental y Control de Plagas",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext.ts",
    "format": "prettier --write src/**/*.ts",
    "db:init": "psql -h localhost -U postgres -f db/init.sql",
    "db:schema": "psql -h localhost -U postgres -f db/schema.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.5",
    "pg-format": "^1.0.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^3.6.0",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.6.6",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "ts-node-dev": "^2.0.3",
    "typescript": "^5.4.5"
  }
}
